{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "school-timetable",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "school-timetable-db",
      "migrations_dir": "migrations",
      "database_id": "c4c3186c-bcfa-4bb9-959f-5086151abce8"
    },
    {
      "binding": "CLASS_SWAP_DB",
      "database_name": "class-swap-db",
      "database_id": "d4e9d2e3-35cb-475f-b128-c78d714cd354",
      "migrations_dir": "vendor/class-swap/migrations"
    }
  ],
  "build": {
    "command": "node scripts/build.mjs"
  },
  "observability": {
    "enabled": false
  },
  "account_id": "965071bae1ca798003675034b0ce7ce5",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "FRONTEND_ORIGIN": "https://cosmicjh.github.io"
  }
}
