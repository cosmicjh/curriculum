{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "school-timetable",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "school-timetable-db",
      "migrations_dir": "migrations",
      "database_id": "c4c3186c-bcfa-4bb9-959f-5086151abce8"
    },
    {
      "binding": "COURSE_DB",
      "database_name": "course-allocation-db",
      "migrations_dir": "vendor/course-allocation/migrations",
      "database_id": "2f1b7cde-5ea8-453b-b810-f372cf138c60"
    }
  ],
  "build": {
    "command": "node scripts/build.mjs"
  },
  "observability": {
    "enabled": false
  },
  "account_id": "965071bae1ca798003675034b0ce7ce5",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "FRONTEND_ORIGIN": "https://cosmicjh.github.io",
    "STUDYROOM_ENABLED": "true",
    "STUDYROOM_CRON_ENABLED": "true"
  }
}
